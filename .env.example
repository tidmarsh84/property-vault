# Copy to .env and fill in. All secrets must be changed for production.
DATABASE_URL="file:./prisma/dev.db"        # or postgres://user:pass@host:5432/propertyvault
INTEGRITY_SIGNING_KEY="change-me-long-random-string"
AUTH_SECRET="change-me-another-long-random-string"
APP_BASE_URL="http://localhost:3000"       # public URL of the deployment
STORAGE_PROVIDER="local"                    # "local" | "s3"
STORAGE_DIR="./storage"                     # local provider only
# S3-compatible storage (required in serverless deployments):
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="property-vault"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
